{
    "mcpServers": {
        "next-devtools": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "next-devtools-mcp@latest"
            ]
        },
        "ESLint": {
            "type": "stdio",
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "@eslint/mcp@latest"
            ]
        },
        "react-docs": {
            "command": "cmd",
            "args": [
                "/c",
                "npx",
                "-y",
                "react-docs-mcp@latest"
            ]
        },
        "arxiv-latex-mcp": {
            "command": "cmd",
            "args": [
                "/c",
                "uv",
                "run",
                "--directory",
                "C:\\Users\\User\\Development\\arxiv-latex-mcp",
                "server\\main.py"
            ]
        },
        "overleaf": {
            "command": "cmd",
            "args": [
                "/c",
                "node",
                "C:\\Users\\User\\Development\\OverleafMCP\\overleaf-mcp-server.js"
            ]
        }
    }
}